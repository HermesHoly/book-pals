---
import booksPublic from "../data/books-public.json";
import "../styles/board.css";
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Book Pals — Daily Literary Puzzle</title>
  </head>
  <body class="min-h-[100dvh] bg-[#121214] text-zinc-100 antialiased selection:bg-blue-600/30 selection:text-blue-200">
    <div class="mx-auto flex min-h-[100dvh] max-w-4xl flex-col px-3.5 py-4 sm:px-6 sm:py-6">
      <!-- Top Header -->
      <header class="flex items-center justify-between gap-2 border-b border-zinc-800/80 pb-3.5 sm:pb-4">
        <div class="flex items-center gap-2.5 min-w-0">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-blue-600/15 border border-blue-500/30 text-lg">
            📚
          </span>
          <div class="min-w-0">
            <h1 class="truncate text-base sm:text-lg font-bold tracking-tight text-zinc-100">Book Pals</h1>
            <p class="truncate text-[11px] sm:text-xs text-zinc-400">Daily Literary Deduction</p>
          </div>
        </div>
        <div class="flex shrink-0 items-center gap-1.5 sm:gap-2">
          <span id="puzzle-badge" class="rounded-full bg-[#18181b] border border-zinc-800 px-2.5 py-1 text-[11px] sm:text-xs font-medium text-zinc-300">
            Puzzle #1
          </span>
          <span id="guess-counter" class="rounded-full bg-blue-600/15 border border-blue-500/30 px-2.5 py-1 text-[11px] sm:text-xs font-semibold text-blue-400">
            0 / 6
          </span>
        </div>
      </header>

      <!-- Search Combobox Section (text-base on mobile prevents iOS Safari input zoom) -->
      <section class="relative mt-4 sm:mt-6" aria-label="Book search">
        <div class="relative flex items-center">
          <svg
            class="pointer-events-none absolute left-4 h-4 w-4 text-zinc-400"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>

          <input
            id="book-search-input"
            type="text"
            autocomplete="off"
            spellcheck="false"
            placeholder="Search book title or author..."
            aria-expanded="false"
            aria-controls="book-search-listbox"
            aria-autocomplete="list"
            role="combobox"
            class="w-full rounded-full bg-[#18181b] border border-zinc-700/70 py-3 sm:py-3.5 pl-11 pr-20 text-base sm:text-sm text-zinc-100 placeholder-zinc-500 shadow-lg transition focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/30 disabled:cursor-not-allowed disabled:opacity-50"
          />

          <button
            id="clear-search-btn"
            type="button"
            class="hidden absolute right-3 min-h-[32px] rounded-full bg-zinc-800 px-3 py-1 text-xs text-zinc-400 hover:bg-zinc-700 hover:text-zinc-200"
          >
            Clear
          </button>
        </div>

        <!-- Dropdown Results (large 44px+ mobile touch targets) -->
        <ul
          id="book-search-listbox"
          role="listbox"
          class="hidden absolute z-30 mt-2 max-h-[55dvh] sm:max-h-80 w-full overflow-y-auto overscroll-contain rounded-2xl bg-[#18181b] border border-zinc-800 p-1.5 shadow-2xl"
        ></ul>
      </section>

      <!-- Guess-3 Author Surname Initial Hint Banner -->
      <div
        id="author-hint-banner"
        class="hidden mt-3.5 sm:mt-4 flex items-center justify-between gap-2 rounded-2xl border border-blue-500/35 bg-blue-600/10 px-3.5 py-2.5 sm:px-4 sm:py-3 text-xs text-blue-200 shadow-[0_0_20px_rgba(37,99,235,0.12)]"
      >
        <div class="flex items-center gap-2.5">
          <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-blue-500/20 text-sm">💡</span>
          <span id="author-hint-text" class="font-medium"></span>
        </div>
        <span class="shrink-0 rounded-full bg-blue-500/20 px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-blue-300">
          Turn 3 Bonus
        </span>
      </div>

      <!-- Error / Status Toast -->
      <div id="status-banner" class="hidden mt-3.5 rounded-2xl border px-4 py-3 text-xs font-medium"></div>

      <!-- Win / Loss End-of-Round Card -->
      <section
        id="round-outcome-card"
        class="hidden mt-4 sm:mt-5 rounded-2xl border p-4 sm:p-5 shadow-2xl transition-all"
        aria-live="polite"
      ></section>

      <!-- 6-Row Guess Board with Sticky Book Column -->
      <section class="mt-4 sm:mt-6 flex-1" aria-label="Guess history board">
        <div class="mb-1.5 flex items-center justify-between sm:hidden text-[11px] text-zinc-500">
          <span>Swipe columns →</span>
          <span>6 Guesses</span>
        </div>

        <div class="overflow-x-auto pb-2 -mx-3.5 px-3.5 sm:mx-0 sm:px-0">
          <div class="min-w-[620px] space-y-2 sm:space-y-2.5">
            <!-- Column Headers -->
            <div class="grid grid-cols-[175px_82px_82px_115px_105px_86px] sm:grid-cols-[2.1fr_1fr_1fr_1.35fr_1.2fr_0.95fr] gap-2 px-0.5 text-[11px] font-semibold uppercase tracking-wider text-zinc-400">
              <div class="sticky-book-col bg-[#121214] py-0.5 pr-2">Book</div>
              <div class="text-center">Year</div>
              <div class="text-center">Pages</div>
              <div class="text-center">Genre</div>
              <div class="text-center">Country</div>
              <div class="text-center">Series</div>
            </div>

            <!-- 6 Guess Slots -->
            <div id="guess-board-rows" class="flip-grid space-y-2 sm:space-y-2.5"></div>
          </div>
        </div>

        <!-- Legend -->
        <div class="mt-3.5 sm:mt-4 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-[11px] sm:text-xs text-zinc-400">
          <span class="flex items-center gap-1.5">
            <span class="h-2.5 w-2.5 rounded-full bg-emerald-500/80 ring-2 ring-emerald-500/30"></span> Exact Match
          </span>
          <span class="flex items-center gap-1.5">
            <span class="h-2.5 w-2.5 rounded-full bg-amber-500/80 ring-2 ring-amber-500/30"></span> Close (±10 yrs / ±15% pgs / Shared genre)
          </span>
          <span class="flex items-center gap-1.5">
            <span class="h-2.5 w-2.5 rounded-full bg-zinc-700 ring-2 ring-zinc-700/40"></span> Miss
          </span>
        </div>
      </section>
    </div>

    <!-- Embed compressed public search catalog -->
    <script id="books-catalog-data" type="application/json" set:html={JSON.stringify(booksPublic)}></script>

    <script>
      import { searchBooks, type PublicBookTuple, type SearchResult } from "../lib/search";
      import type { GuessComparisonResult, Direction } from "../lib/comparison";

      type GameStatus = "IN_PROGRESS" | "WON" | "LOST";

      const MAX_GUESSES = 6;

      const catalogEl = document.getElementById("books-catalog-data");
      const catalog: PublicBookTuple[] = catalogEl ? JSON.parse(catalogEl.textContent || "[]") : [];

      const input = document.getElementById("book-search-input") as HTMLInputElement;
      const listbox = document.getElementById("book-search-listbox") as HTMLUListElement;
      const clearBtn = document.getElementById("clear-search-btn") as HTMLButtonElement;
      const puzzleBadgeEl = document.getElementById("puzzle-badge") as HTMLElement;
      const counterEl = document.getElementById("guess-counter") as HTMLElement;
      const boardRowsEl = document.getElementById("guess-board-rows") as HTMLElement;
      const statusBannerEl = document.getElementById("status-banner") as HTMLElement;
      const hintBannerEl = document.getElementById("author-hint-banner") as HTMLElement;
      const hintTextEl = document.getElementById("author-hint-text") as HTMLElement;
      const outcomeCardEl = document.getElementById("round-outcome-card") as HTMLElement;

      let puzzleNumber = 1;
      let gameStatus: GameStatus = "IN_PROGRESS";
      let authorHintLetter: string | null = null;
      const guessedIds = new Set<number>();
      const guesses: GuessComparisonResult[] = [];
      let currentResults: SearchResult[] = [];
      let activeIndex = -1;
      let isSubmitting = false;

      function escapeHtml(str: string): string {
        return str
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;");
      }

      function tileClasses(status: "exact" | "close" | "partial" | "miss"): string {
        if (status === "exact") {
          return "bg-[#142922] border-emerald-500/50 text-emerald-200 shadow-[0_0_15px_rgba(16,185,129,0.12)]";
        }
        if (status === "close" || status === "partial") {
          return "bg-[#292114] border-amber-500/50 text-amber-200 shadow-[0_0_15px_rgba(245,158,11,0.12)]";
        }
        return "bg-[#18181b] border-zinc-800 text-zinc-300";
      }

      function directionBadge(dir: Direction): string {
        if (dir === "up") return `<span class="text-xs font-bold">⬆️</span>`;
        if (dir === "down") return `<span class="text-xs font-bold">⬇️</span>`;
        return "";
      }

      function updateControlsForState() {
        puzzleBadgeEl.textContent = `Puzzle #${puzzleNumber}`;
        counterEl.textContent = `${guesses.length} / ${MAX_GUESSES}`;

        if (authorHintLetter) {
          hintTextEl.innerHTML = `Hint Unlocked: Author's surname starts with <strong class="rounded bg-blue-500/25 px-1.5 py-0.5 font-mono text-sm text-white">${escapeHtml(authorHintLetter)}</strong>`;
          hintBannerEl.classList.remove("hidden");
        } else {
          hintBannerEl.classList.add("hidden");
        }

        if (gameStatus === "IN_PROGRESS") {
          input.disabled = isSubmitting;
          input.placeholder = "Search book title or author...";
        } else {
          input.disabled = true;
          input.placeholder =
            gameStatus === "WON"
              ? `Solved in ${guesses.length}/${MAX_GUESSES} guesses!`
              : "Out of guesses — see the hidden book below.";
        }
      }

      function renderOutcomeCard(answer: NonNullable<GuessComparisonResult["revealedAnswer"]>) {
        const isWin = gameStatus === "WON";
        outcomeCardEl.className = isWin
          ? "mt-4 sm:mt-5 rounded-2xl border border-emerald-500/40 bg-emerald-500/10 p-4 sm:p-5 shadow-2xl"
          : "mt-4 sm:mt-5 rounded-2xl border border-zinc-700 bg-[#18181b] p-4 sm:p-5 shadow-2xl";

        const badgeText = isWin
          ? `🎉 Solved in ${guesses.length} / ${MAX_GUESSES}`
          : "📖 Better luck next time";
        const badgeColor = isWin
          ? "bg-emerald-500/20 text-emerald-300 border-emerald-500/40"
          : "bg-zinc-800 text-zinc-300 border-zinc-700";

        outcomeCardEl.innerHTML = `
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="space-y-1">
              <span class="inline-block rounded-full border px-3 py-0.5 text-xs font-semibold ${badgeColor}">
                ${badgeText}
              </span>
              <h2 class="pt-1 text-lg sm:text-xl font-bold tracking-tight text-zinc-100">${escapeHtml(answer.title)}</h2>
              <p class="text-xs sm:text-sm text-zinc-300">by <span class="font-semibold text-white">${escapeHtml(answer.author)}</span></p>
              <div class="flex flex-wrap gap-1.5 sm:gap-2 pt-1.5 text-[11px] sm:text-xs text-zinc-400">
                <span class="rounded-lg bg-zinc-900/90 border border-zinc-800 px-2.5 py-1">📅 ${answer.firstPublishYear}</span>
                <span class="rounded-lg bg-zinc-900/90 border border-zinc-800 px-2.5 py-1">📄 ${answer.medianPages} pages</span>
                <span class="rounded-lg bg-zinc-900/90 border border-zinc-800 px-2.5 py-1">🏷️ ${escapeHtml(answer.primaryGenre)}</span>
                <span class="rounded-lg bg-zinc-900/90 border border-zinc-800 px-2.5 py-1">🌍 ${escapeHtml(answer.authorCountry)}</span>
                <span class="rounded-lg bg-zinc-900/90 border border-zinc-800 px-2.5 py-1">${answer.isSeries ? "📚 Series" : "📕 Standalone"}</span>
              </div>
            </div>
            <button
              id="next-test-puzzle-btn"
              type="button"
              class="min-h-[42px] shrink-0 rounded-full bg-blue-600 px-5 py-2.5 text-xs font-semibold text-white shadow-lg transition hover:bg-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-400"
            >
              Play Puzzle #${puzzleNumber + 1} →
            </button>
          </div>
        `;

        const nextBtn = document.getElementById("next-test-puzzle-btn");
        nextBtn?.addEventListener("click", () => {
          startPuzzle(puzzleNumber + 1);
        });
      }

      function startPuzzle(nextNumber: number) {
        puzzleNumber = nextNumber;
        gameStatus = "IN_PROGRESS";
        authorHintLetter = null;
        guessedIds.clear();
        guesses.length = 0;
        currentResults = [];
        activeIndex = -1;
        outcomeCardEl.className = "hidden";
        outcomeCardEl.innerHTML = "";
        statusBannerEl.classList.add("hidden");
        input.value = "";
        clearBtn.classList.add("hidden");
        closeDropdown();
        updateControlsForState();
        renderBoard(false);
        input.focus();
      }

      function renderBoard(animateLatest = false) {
        const rowsHtml: string[] = [];

        for (let rowIdx = 0; rowIdx < MAX_GUESSES; rowIdx++) {
          const entry = guesses[rowIdx];

          if (!entry) {
            rowsHtml.push(`
              <div class="grid grid-cols-[175px_82px_82px_115px_105px_86px] sm:grid-cols-[2.1fr_1fr_1fr_1.35fr_1.2fr_0.95fr] gap-2">
                <div class="sticky-book-col h-14 rounded-xl bg-[#161619] border border-zinc-800/60"></div>
                <div class="h-14 rounded-xl bg-[#18181b]/50 border border-zinc-800/60"></div>
                <div class="h-14 rounded-xl bg-[#18181b]/50 border border-zinc-800/60"></div>
                <div class="h-14 rounded-xl bg-[#18181b]/50 border border-zinc-800/60"></div>
                <div class="h-14 rounded-xl bg-[#18181b]/50 border border-zinc-800/60"></div>
                <div class="h-14 rounded-xl bg-[#18181b]/50 border border-zinc-800/60"></div>
              </div>
            `);
            continue;
          }

          const shouldFlip = animateLatest && rowIdx === guesses.length - 1;
          const flipClass = shouldFlip ? "tile-flip" : "";
          const delay = (col: number) => (shouldFlip ? `style="animation-delay: ${col * 110}ms"` : "");

          const { guess, evaluation } = entry;
          const bookStatus = evaluation.isCorrect ? "exact" : "miss";

          rowsHtml.push(`
            <div class="grid grid-cols-[175px_82px_82px_115px_105px_86px] sm:grid-cols-[2.1fr_1fr_1fr_1.35fr_1.2fr_0.95fr] gap-2">
              <!-- Sticky Book Title & Author -->
              <div ${delay(0)} class="${flipClass} sticky-book-col flex flex-col justify-center rounded-xl border px-3 py-2 min-w-0 ${tileClasses(bookStatus)}">
                <div class="truncate text-xs font-bold text-zinc-100" title="${escapeHtml(guess.title)}">${escapeHtml(guess.title)}</div>
                <div class="truncate text-[11px] text-zinc-400" title="${escapeHtml(guess.author)}">${escapeHtml(guess.author)}</div>
              </div>

              <!-- Publication Year -->
              <div ${delay(1)} class="${flipClass} flex flex-col items-center justify-center rounded-xl border px-2 py-2 text-center ${tileClasses(evaluation.year.status)}">
                <div class="flex items-center gap-1 text-xs font-bold font-mono">
                  <span>${guess.firstPublishYear}</span>
                  ${directionBadge(evaluation.year.direction)}
                </div>
                <span class="text-[10px] uppercase tracking-wide opacity-75">${evaluation.year.status}</span>
              </div>

              <!-- Page Count -->
              <div ${delay(2)} class="${flipClass} flex flex-col items-center justify-center rounded-xl border px-2 py-2 text-center ${tileClasses(evaluation.pages.status)}">
                <div class="flex items-center gap-1 text-xs font-bold font-mono">
                  <span>${guess.medianPages}p</span>
                  ${directionBadge(evaluation.pages.direction)}
                </div>
                <span class="text-[10px] uppercase tracking-wide opacity-75">${evaluation.pages.status}</span>
              </div>

              <!-- Primary Genre -->
              <div ${delay(3)} class="${flipClass} flex flex-col items-center justify-center rounded-xl border px-2 py-2 text-center ${tileClasses(evaluation.genre.status)}">
                <span class="line-clamp-1 text-xs font-semibold">${escapeHtml(guess.primaryGenre)}</span>
                <span class="text-[10px] uppercase tracking-wide opacity-75">${evaluation.genre.status}</span>
              </div>

              <!-- Author Country -->
              <div ${delay(4)} class="${flipClass} flex flex-col items-center justify-center rounded-xl border px-2 py-2 text-center ${tileClasses(evaluation.country.status)}">
                <span class="line-clamp-1 text-xs font-semibold">${escapeHtml(guess.authorCountry)}</span>
                <span class="text-[10px] uppercase tracking-wide opacity-75">${evaluation.country.status}</span>
              </div>

              <!-- Series Status -->
              <div ${delay(5)} class="${flipClass} flex flex-col items-center justify-center rounded-xl border px-2 py-2 text-center ${tileClasses(evaluation.series.status)}">
                <span class="text-xs font-semibold">${guess.isSeries ? "Series" : "Standalone"}</span>
                <span class="text-[10px] uppercase tracking-wide opacity-75">${evaluation.series.status}</span>
              </div>
            </div>
          `);
        }

        boardRowsEl.innerHTML = rowsHtml.join("");
      }

      function closeDropdown() {
        listbox.classList.add("hidden");
        input.setAttribute("aria-expanded", "false");
        activeIndex = -1;
      }

      function renderDropdown() {
        if (currentResults.length === 0) {
          if (input.value.trim().length > 0) {
            listbox.innerHTML = `<li class="px-4 py-3 text-xs text-zinc-500">No matching books found.</li>`;
            listbox.classList.remove("hidden");
            input.setAttribute("aria-expanded", "true");
          } else {
            closeDropdown();
          }
          return;
        }

        listbox.innerHTML = currentResults
          .map((item, idx) => {
            const isActive = idx === activeIndex;
            return `
              <li
                role="option"
                data-index="${idx}"
                aria-selected="${isActive}"
                class="flex min-h-[46px] cursor-pointer items-center justify-between rounded-xl px-3.5 py-2.5 text-left transition ${
                  isActive
                    ? "bg-blue-600/20 text-zinc-100 ring-1 ring-blue-500/40"
                    : "text-zinc-200 hover:bg-zinc-800/80"
                }"
              >
                <div class="min-w-0 pr-3">
                  <div class="truncate text-sm font-medium text-zinc-100">${escapeHtml(item.title)}</div>
                  <div class="truncate text-xs text-zinc-400">${escapeHtml(item.author)}</div>
                </div>
                <span class="shrink-0 rounded-full bg-zinc-800/90 border border-zinc-700/60 px-2.5 py-0.5 text-xs font-mono text-zinc-300">
                  ${item.year}
                </span>
              </li>
            `;
          })
          .join("");

        listbox.classList.remove("hidden");
        input.setAttribute("aria-expanded", "true");
      }

      async function submitGuess(book: SearchResult) {
        if (isSubmitting || gameStatus !== "IN_PROGRESS" || guesses.length >= MAX_GUESSES) return;

        isSubmitting = true;
        input.value = "";
        clearBtn.classList.add("hidden");
        closeDropdown();
        statusBannerEl.classList.add("hidden");
        updateControlsForState();

        try {
          const turn = guesses.length + 1;
          const res = await fetch("/api/guess", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              puzzleNumber,
              guessId: book.id,
              turn,
            }),
          });

          if (!res.ok) {
            throw new Error(`Server returned ${res.status}`);
          }

          const comparison: GuessComparisonResult = await res.json();
          guessedIds.add(book.id);
          guesses.push(comparison);

          if (comparison.authorSurnameHint && !authorHintLetter) {
            authorHintLetter = comparison.authorSurnameHint;
          }

          if (comparison.evaluation.isCorrect) {
            gameStatus = "WON";
          } else if (guesses.length >= MAX_GUESSES) {
            gameStatus = "LOST";
          }

          renderBoard(true);

          if (comparison.revealedAnswer && gameStatus !== "IN_PROGRESS") {
            setTimeout(() => {
              if (comparison.revealedAnswer) {
                renderOutcomeCard(comparison.revealedAnswer);
              }
            }, 700);
          }
        } catch {
          statusBannerEl.textContent = "Could not evaluate guess. Make sure Wrangler dev server is running.";
          statusBannerEl.className =
            "mt-3.5 rounded-2xl border border-red-500/40 bg-red-500/10 px-4 py-3 text-xs font-medium text-red-200";
        } finally {
          isSubmitting = false;
          updateControlsForState();
          if (gameStatus === "IN_PROGRESS") {
            input.focus();
          }
        }
      }

      input.addEventListener("input", () => {
        const q = input.value;
        clearBtn.classList.toggle("hidden", q.length === 0);
        currentResults = searchBooks(catalog, q, guessedIds, 8);
        activeIndex = currentResults.length > 0 ? 0 : -1;
        renderDropdown();
      });

      input.addEventListener("keydown", (e) => {
        if (listbox.classList.contains("hidden") || currentResults.length === 0) return;

        if (e.key === "ArrowDown") {
          e.preventDefault();
          activeIndex = (activeIndex + 1) % currentResults.length;
          renderDropdown();
        } else if (e.key === "ArrowUp") {
          e.preventDefault();
          activeIndex = (activeIndex - 1 + currentResults.length) % currentResults.length;
          renderDropdown();
        } else if (e.key === "Enter" && activeIndex >= 0) {
          e.preventDefault();
          submitGuess(currentResults[activeIndex]);
        } else if (e.key === "Escape") {
          closeDropdown();
        }
      });

      listbox.addEventListener("click", (e) => {
        const target = (e.target as HTMLElement).closest("li[data-index]") as HTMLLIElement | null;
        if (!target) return;
        const idx = Number(target.dataset.index);
        if (currentResults[idx]) {
          submitGuess(currentResults[idx]);
        }
      });

      clearBtn.addEventListener("click", () => {
        input.value = "";
        clearBtn.classList.add("hidden");
        closeDropdown();
        input.focus();
      });

      document.addEventListener("click", (e) => {
        if (!input.contains(e.target as Node) && !listbox.contains(e.target as Node)) {
          closeDropdown();
        }
      });

      updateControlsForState();
      renderBoard(false);
    </script>
  </body>
</html>
